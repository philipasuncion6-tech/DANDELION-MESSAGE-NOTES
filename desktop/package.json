{
  "name": "dandelion-message-notes",
  "version": "1.0.0",
  "description": "Dandelion Message Notes Windows Desktop App",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "keywords": [],
  "author": "Philip Asuncion",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.philipasuncion.dandelionmessagenotes",
    "productName": "Dandelion Message Notes",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "dandelion-message-notes.ico",
      "node_modules/@ffmpeg/ffmpeg/dist/esm/**/*",
      "node_modules/@ffmpeg/core/dist/esm/**/*",
      "node_modules/@ffmpeg/ffmpeg/package.json",
      "node_modules/@ffmpeg/core/package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "dandelion-message-notes.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Dandelion Message Notes"
    }
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.10"
  }
}
